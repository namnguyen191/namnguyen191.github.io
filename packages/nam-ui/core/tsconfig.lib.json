{
  "extends": "@repo/shared-configs/typescript/base",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "composite": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/scripts/**"]
}
