{
  "name": "@nam-ui/react",
  "version": "0.0.0",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-d.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@nam-ui/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "@nam-ui/source": "./src/components/*/index.ts",
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./unstyled": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/unstyled/index.js"
    },
    "./unstyled/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/unstyled/components/*/index.js"
    },
    "./styles.css": {
      "types": "./dist/types/css.d.ts",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "types": "./dist/types/css.d.ts",
      "default": "./dist/components/*/*.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check-types": "tsc -b --noEmit",
    "test": "echo 'Tests for @nam-ui/react run from nam-ui-react-storybook'",
    "lint": "oxlint --type-aware --max-warnings 0 && publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nam-ui/core": "workspace:*",
    "@repo/shared-configs": "workspace:*",
    "@types/node": "catalog:typescript-latest",
    "@types/react": "catalog:react-latest",
    "@types/react-dom": "catalog:react-latest",
    "@typescript/native": "catalog:typescript-latest",
    "@vitejs/plugin-react": "catalog:react-latest",
    "oxfmt": "catalog:",
    "oxlint": "catalog:oxlint-latest",
    "oxlint-tsgolint": "catalog:oxlint-latest",
    "publint": "catalog:",
    "react": "catalog:react-latest",
    "react-dom": "catalog:react-latest",
    "sass": "catalog:",
    "typescript": "catalog:typescript-latest",
    "vite": "catalog:vite-latest",
    "vite-plugin-dts": "catalog:vite-latest",
    "vitest": "catalog:vite-latest"
  },
  "peerDependencies": {
    "@nam-ui/core": "workspace:^",
    "react": "^19.0.0"
  }
}
