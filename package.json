{
  "name": "@namnguyen191/root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "build:all": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "build:affected": "turbo build --affected",
    "dev:all": "turbo dev",
    "lint:all": "turbo lint",
    "lint:affected": "turbo lint --affected",
    "test:all": "turbo test",
    "test:affected": "turbo test --affected",
    "format:all": "prettier --write \"**/*.{ts,tsx,md,json,html,js,jsx}\"",
    "format": "prettier --write",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish",
    "publish-angular-packages": "turbo run publish-angular-lib",
    "start-local-registry": "verdaccio",
    "clean": "rm -rf node_modules && rm -rf **/node_modules && pnpm store prune"
  },
  "devDependencies": {
    "@angular/cli": "catalog:angular-latest",
    "@changesets/cli": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:turbo-latest",
    "typescript": "catalog:typescript-latest",
    "verdaccio": "catalog:"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24"
  }
}
