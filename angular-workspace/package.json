{
  "name": "angular-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "check-types": "tsc -b --noEmit",
    "publish-angular-lib": "pnpm publish dist/common-angular-helper",
    "lint": "oxlint --type-aware --max-warnings 0 && eslint . --max-warnings 0"
  },
  "dependencies": {
    "@angular/animations": "catalog:angular-latest",
    "@angular/common": "catalog:angular-latest",
    "@angular/compiler": "catalog:angular-latest",
    "@angular/core": "catalog:angular-latest",
    "@angular/forms": "catalog:angular-latest",
    "@angular/platform-browser": "catalog:angular-latest",
    "@angular/platform-browser-dynamic": "catalog:angular-latest",
    "@angular/router": "catalog:angular-latest",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "zone.js": "catalog:"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "catalog:angular-latest",
    "@angular/cli": "catalog:angular-latest",
    "@angular/compiler-cli": "catalog:angular-latest",
    "@repo/shared-configs": "workspace:*",
    "@types/node": "catalog:typescript-latest",
    "@typescript/native": "catalog:typescript-latest",
    "eslint": "catalog:eslint-latest",
    "ng-packagr": "catalog:angular-latest",
    "oxlint": "catalog:oxlint-latest",
    "oxlint-tsgolint": "catalog:oxlint-latest",
    "type-fest": "catalog:",
    "typescript": "catalog:typescript-latest"
  }
