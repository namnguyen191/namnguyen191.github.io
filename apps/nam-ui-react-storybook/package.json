{
  "name": "nam-ui-react-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 -c ./src",
    "build": "storybook build -c ./src",
    "lint": "oxlint --type-aware --max-warnings 0",
    "check-types": "tsc -b --noEmit",
    "test": "vitest run --coverage",
    "test:update": "vitest run --update"
  },
  "dependencies": {
    "@nam-ui/core": "workspace:*",
    "@nam-ui/react": "workspace:*",
    "react": "catalog:react-latest",
    "react-dom": "catalog:react-latest"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:storybook-latest",
    "@repo/shared-configs": "workspace:*",
    "@storybook/addon-a11y": "catalog:storybook-latest",
    "@storybook/addon-docs": "catalog:storybook-latest",
    "@storybook/addon-vitest": "catalog:storybook-latest",
    "@storybook/react-vite": "catalog:storybook-latest",
    "@types/node": "catalog:typescript-latest",
    "@types/react": "catalog:react-latest",
    "@vitejs/plugin-react": "catalog:react-latest",
    "@vitest/browser-playwright": "catalog:vite-latest",
    "@vitest/coverage-v8": "catalog:vite-latest",
    "oxlint": "catalog:oxlint-latest",
    "playwright": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:storybook-latest",
    "storybook-addon-pseudo-states": "catalog:storybook-latest",
    "typescript": "~7.0.2",
    "vite": "catalog:vite-latest",
    "vitest": "catalog:vite-latest"
  }
}
